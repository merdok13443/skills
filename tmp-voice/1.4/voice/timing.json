{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.74,
   "text": "מצרים נמצאת באפריקה או באסיה, אמת או שקר?"
  },
  {
   "id": "p",
   "s": 4.74,
   "e": 6.02,
   "text": "באפריקה, ברור שאמת."
  },
  {
   "id": "sinai",
   "s": 6.32,
   "e": 9.14,
   "text": "וחלק ממצרים, חצי האי סיני, נמצא באסיה."
  },
  {
   "id": "both",
   "s": 9.48,
   "e": 11.6,
   "text": "שניהם אמת, והמשפט אמת."
  },
  {
   "id": "msg",
   "s": 12.3,
   "e": 16.8,
   "text": "״או״ בלוגיקה אמת גם כששני הצדדים אמת, ושקר רק כששניהם שקר."
  },
  {
   "id": "n1",
   "s": 17.2,
   "e": 20.94,
   "text": "שלוש גדול מאחת, או תשע גדול מארבע: אמת."
  },
  {
   "id": "myth",
   "s": 21.56,
   "e": 24.1,
   "text": "בדיבור ״או״ נשמע לפעמים כמו רק אחד."
  },
  {
   "id": "xor",
   "s": 24.38,
   "e": 25.36,
   "text": "זה ״או מוציא״."
  },
  {
   "id": "lead",
   "s": 25.72,
   "e": 26.88,
   "text": "ואיתו המשפט שקר."
  },
  {
   "id": "pay",
   "s": 27.3,
   "e": 29.1,
   "text": "ה״או״ של הלוגיקה כולל."
  },
  {
   "id": "n2",
   "s": 29.54,
   "e": 31.42,
   "text": "צד אחד שקר: עדיין אמת."
  },
  {
   "id": "n3",
   "s": 31.66,
   "e": 33.62,
   "text": "שני הצדדים שקר: שקר."
  },
  {
   "id": "recap",
   "s": 34.08,
   "e": 37.06,
   "text": "אמת גם כששניהם אמת, שקר רק כששניהם שקר."
  },
  {
   "id": "loop",
   "s": 37.34,
   "e": 38.2,
   "text": "אז שוב:"
  }
 ],
