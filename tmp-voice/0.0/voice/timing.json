{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 3.08,
   "text": "כמה צעדי חברות בינך לבין זר בפייסבוק?"
  },
  {
   "id": "fact",
   "s": 3.56,
   "e": 5.95,
   "text": "בממוצע, רק ארבע נקודה חמש שבע."
  },
  {
   "id": "msg",
   "s": 6.78,
   "e": 11.76,
   "text": "בדידה היא המתמטיקה של ספירה ורשתות, שמלמדת לחשוב מדויק ולהוכיח."
  },
  {
   "id": "lead",
   "s": 12.32,
   "e": 14.18,
   "text": "ויש דברים שמוכיחים בלי למדוד."
  },
  {
   "id": "try",
   "s": 14.62,
   "e": 17.94,
   "text": "ארבעה אנשים עם אפס, אחד, שניים ושלושה חברים?"
  },
  {
   "id": "why",
   "s": 18.4,
   "e": 20.94,
   "text": "אבל שלושה זה חבר של כולם, אז אין אפס."
  },
  {
   "id": "left",
   "s": 21.2,
   "e": 23.34,
   "text": "נשארו שלושה מספרים לארבעה אנשים."
  },
  {
   "id": "pay",
   "s": 23.76,
   "e": 27.84,
   "text": "בכל רשת, תמיד יש שניים עם אותו מספר חברים, גם בפייסבוק."
  },
  {
   "id": "recap",
   "s": 28.28,
   "e": 31.6,
   "text": "זאת בדידה: ספירה, רשתות, דיוק והוכחה."
  },
  {
   "id": "loop",
   "s": 31.88,
   "e": 33.8,
   "text": "אז לפני שמתחילים, נחש:"
  }
 ],
