{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.88,
   "text": "כמה צעדי חברות בינך לבין זר בפייסבוק?"
  },
  {
   "id": "ans",
   "s": 3.4,
   "e": 6.62,
   "text": "בממוצע, בערך ארבעה וחצי."
  },
  {
   "id": "msg",
   "s": 7.26,
   "e": 12.04,
   "text": "מתמטיקה בדידה: לחשוב מדויק, להוכיח, לספור ולמפות רשתות."
  },
  {
   "id": "map",
   "s": 12.74,
   "e": 16.14,
   "text": "ממפים: משתמש הוא נקודה, חברות היא קו."
  },
  {
   "id": "def",
   "s": 16.44,
   "e": 18.74,
   "text": "מגדירים בדיוק: צעד הוא קו אחד."
  },
  {
   "id": "count",
   "s": 19.04,
   "e": 21.22,
   "text": "סופרים צעדים במסלול הקצר ביותר."
  },
  {
   "id": "lead",
   "s": 21.48,
   "e": 25.38,
   "text": "ועל כל רשת של שניים ומעלה, מוכיחים בלי למדוד:"
  },
  {
   "id": "pay",
   "s": 25.62,
   "e": 28.28,
   "text": "תמיד יש שני משתמשים עם אותו מספר חברים."
  },
  {
   "id": "recap",
   "s": 28.88,
   "e": 33.88,
   "text": "זאת מתמטיקה בדידה: לחשוב מדויק, להוכיח, לספור, למפות."
  },
  {
   "id": "loop",
   "s": 34.38,
   "e": 36.5,
   "text": "אז לפני שמתחילים, נחש:"
  }
 ],
