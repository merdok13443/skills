{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.56,
   "text": "כמה צעדי חברות בינך לבין זר בפייסבוק?"
  },
  {
   "id": "fact",
   "s": 3.24,
   "e": 6.69,
   "text": "בממוצע, רק ארבע נקודה חמש שבע."
  },
  {
   "id": "msg",
   "s": 7.04,
   "e": 12.16,
   "text": "בדידה היא המתמטיקה של ספירה ורשתות, והיא מלמדת לחשוב מדויק ולהוכיח."
  },
  {
   "id": "map",
   "s": 13.24,
   "e": 16.14,
   "text": "ממפים: משתמש הוא נקודה, חברות היא קו."
  },
  {
   "id": "def",
   "s": 16.52,
   "e": 18.42,
   "text": "צעד הוא בדיוק קו אחד."
  },
  {
   "id": "count",
   "s": 18.96,
   "e": 21.1,
   "text": "סופרים צעדים במסלול הקצר ביותר."
  },
  {
   "id": "lead",
   "s": 21.68,
   "e": 25.4,
   "text": "ועל כל רשת סופית של שניים ומעלה, מוכיחים בלי למדוד:"
  },
  {
   "id": "pay",
   "s": 26.2,
   "e": 29.2,
   "text": "תמיד יש שני משתמשים עם אותו מספר חברים."
  },
  {
   "id": "recap",
   "s": 30.35,
   "e": 34.74,
   "text": "זאת בדידה: לספור, למפות, לחשוב מדויק, להוכיח."
  },
  {
   "id": "loop",
   "s": 35.46,
   "e": 37.52,
   "text": "אז לפני שמתחילים, נחש:"
  }
 ],
