{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 2.88,
   "text": "כמה צעדי חברות בינך לבין זר בפייסבוק?"
  },
  {
   "id": "ans",
   "s": 3.28,
   "e": 5.76,
   "text": "בממוצע, בערך ארבעה וחצי."
  },
  {
   "id": "msg",
   "s": 6.76,
   "e": 13.56,
   "text": "בדידה היא כלי היסוד של מדעי המחשב: לחשוב מדויק, להוכיח, לספור ולמפות רשתות."
  },
  {
   "id": "map",
   "s": 14.1,
   "e": 17.78,
   "text": "ממפים: משתמש הוא נקודה, חברות היא קו."
  },
  {
   "id": "def",
   "s": 18.24,
   "e": 21.16,
   "text": "מגדירים בדיוק: צעד הוא קו אחד."
  },
  {
   "id": "count",
   "s": 21.88,
   "e": 24.4,
   "text": "סופרים צעדים במסלול הקצר ביותר."
  },
  {
   "id": "lead",
   "s": 24.96,
   "e": 28.64,
   "text": "ועל כל רשת של שניים ומעלה, מוכיחים בלי למדוד:"
  },
  {
   "id": "pay",
   "s": 29.44,
   "e": 32.76,
   "text": "תמיד יש שני משתמשים עם אותו מספר חברים."
  },
  {
   "id": "recap",
   "s": 33.56,
   "e": 39.06,
   "text": "זאת בדידה: לחשוב מדויק, להוכיח, לספור, למפות."
  },
  {
   "id": "loop",
   "s": 39.7,
   "e": 41.82,
   "text": "אז לפני שמתחילים, נחש:"
  }
 ],
