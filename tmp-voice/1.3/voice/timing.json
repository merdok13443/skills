{
 "lines": [
  {
   "id": "hook",
   "s": 0.0,
   "e": 4.66,
   "text": "ווייז הומצאה בישראל, וגם גוגל קנתה אותה. אמת או שקר?"
  },
  {
   "id": "def",
   "s": 5.7,
   "e": 8.24,
   "text": "״וגם״ מחבר שני פסוקים לפסוק אחד."
  },
  {
   "id": "msg",
   "s": 8.76,
   "e": 14.16,
   "text": "״וגם״ אמת רק כששני החלקים אמת. חלק שקרי אחד מפיל הכול."
  },
  {
   "id": "p",
   "s": 14.86,
   "e": 16.96,
   "text": "הומצאה בישראל? אמת."
  },
  {
   "id": "fact",
   "s": 17.48,
   "e": 21.62,
   "text": "גוגל קנתה אותה, באלפיים, ושלוש עשרה, בכמיליארד, דולר."
  },
  {
   "id": "bridge",
   "s": 22.32,
   "e": 26.8,
   "text": "ישראלים הקימו, גוגל קנתה: טי וגם טי, אמת."
  },
  {
   "id": "swap",
   "s": 27.57,
   "e": 30.72,
   "text": "ואם נחליף מילה אחת: גוגל הקימה אותה?"
  },
  {
   "id": "pay",
   "s": 31.24,
   "e": 34.54,
   "text": "חצי נכון, ועדיין כל המשפט שקר."
  },
  {
   "id": "ff",
   "s": 35.64,
   "e": 38.98,
   "text": "ושתיים גדולה מחמש, וגם מה שתרצו? שקר."
  },
  {
   "id": "recap",
   "s": 39.38,
   "e": 43.02,
   "text": "רק כששניהם אמת. חלק שקרי אחד מפיל הכול."
  },
  {
   "id": "loop",
   "s": 43.82,
   "e": 44.54,
   "text": "אז תגידו לי:"
  }
 ],
